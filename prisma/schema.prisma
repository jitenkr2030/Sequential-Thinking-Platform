// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Knowledge Graph Models
model Domain {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tools       Tool[]
  reasoningMaps ReasoningMap[]
  sessions    LearningSession[]
  
  @@map("domains")
}

model Tool {
  id            String   @id @default(cuid())
  name          String
  description   String
  category      String   // e.g., "calculator", "database", "analyzer"
  domainId      String
  inputSchema   String?  // JSON schema for tool inputs
  outputSchema  String?  // JSON schema for tool outputs
  apiEndpoint   String?  // For external tools
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  domain        Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  stepTools     StepTool[]
  thoughtTools  ThoughtTool[]
  
  @@map("tools")
}

model ReasoningStep {
  id              String   @id @default(cuid())
  title           String
  description     String
  expectedOutcome String
  timeEstimate    Int      // in minutes
  order           Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  mapId           String
  reasoningMap    ReasoningMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  stepTools       StepTool[]
  
  @@map("reasoning_steps")
}

model StepTool {
  id           String   @id @default(cuid())
  stepId       String
  toolId       String
  confidence   Float    // 0.0 to 1.0
  rationale    String?
  priority     Int      @default(1)
  suggestedInputs String? // JSON
  createdAt    DateTime @default(now())
  
  step         ReasoningStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  tool         Tool          @relation(fields: [toolId], references: [id], onDelete: Cascade)
  
  @@unique([stepId, toolId])
  @@map("step_tools")
}

model ReasoningMap {
  id          String   @id @default(cuid())
  title       String
  description String?
  difficulty  String   // "beginner", "intermediate", "advanced"
  domainId    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  domain      Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)
  steps       ReasoningStep[]
  sessions    LearningSession[]
  
  @@map("reasoning_maps")
}

// Learning Session Models
model LearningSession {
  id              String   @id @default(cuid())
  userId          String?
  mapId           String?
  mode            String   // "self-study", "exam-simulation", "teaching"
  domainId        String
  problem         String
  status          String   // "active", "completed", "paused"
  startTime       DateTime @default(now())
  endTime         DateTime?
  totalScore      Float?
  reasoningScore  Float?
  toolUsageScore  Float?
  accuracyScore   Float?
  timeScore       Float?
  
  user            User?           @relation(fields: [userId], references: [id])
  domain          Domain          @relation(fields: [domainId], references: [id])
  map             ReasoningMap?    @relation(fields: [mapId], references: [id])
  thoughts        Thought[]
  
  @@map("learning_sessions")
}

model Thought {
  id                    String   @id @default(cuid())
  sessionId             String
  thoughtNumber         Int
  totalThoughts         Int
  content               String
  isRevision            Boolean  @default(false)
  revisesThought        Int?
  branchFromThought     Int?
  branchId              String?
  nextThoughtNeeded     Boolean  @default(true)
  processingTime        Int?     // in milliseconds
  createdAt             DateTime @default(now())
  
  session               LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  thoughtTools          ThoughtTool[]
  
  @@map("thoughts")
}

model ThoughtTool {
  id           String   @id @default(cuid())
  thoughtId    String
  toolId       String
  confidence   Float
  rationale    String?
  priority     Int      @default(1)
  used         Boolean   @default(false)
  effectiveness Float?  // 0.0 to 1.0
  createdAt    DateTime @default(now())
  
  thought      Thought  @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  tool         Tool     @relation(fields: [toolId], references: [id])
  
  @@map("thought_tools")
}

// Legacy models (can be removed if not needed)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  posts     Post[]
  sessions  LearningSession[]
  
  @@map("users")
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  @@map("posts")
}